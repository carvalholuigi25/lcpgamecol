{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "paths": {
      "@public/*": ["./public/*"],
      "@nmodules/*": ["./node_modules/*"]
    }
  },
  "include": [
    "public/**/*.js",
    "scripts/**/*.js",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".venv",
    ".venv-1",
    ".venv-wsl",
    "mycoverage"
  ]
}
