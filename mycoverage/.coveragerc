[run]
branch = True
source = .
data_file = .coverage
omit =
    tests/*
    .venv/*
    node_modules/*
    mycoverage/*

[report]
show_missing = True
skip_empty = True
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError

[html]
directory =  mycoverage/htmlcov
title = lcpgamecol coverage

[json]
output = coverage.json
