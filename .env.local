# Copy to .env.local (not committed) and adjust.
#
# Where the FastAPI backend runs. Phones cannot reach 127.0.0.1: use your computer's
# LAN address (for example http://192.168.1.20:8000), 10.0.2.2 from the Android
# emulator, or a tunnel. EXPO_PUBLIC_ values are bundled into the app: no secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8000
