{
  "name": "lcpgamecolwapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-updates": "~58.0.23",
    "i18next": "^27.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "startwatch": "expo start --dev-client",
    "startwocache": "npm start -- --reset-cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "pubupdate": "npx eas-cli@latest update",
    "api:types": "npx --yes openapi-typescript@7.13.0 ../openapi.json -o src/api/schema.d.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ]
  },
  "private": true,
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
